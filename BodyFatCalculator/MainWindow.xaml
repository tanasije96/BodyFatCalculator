<Window x:Class="BodyFatCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BodyFatCalculator"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="400">
    <StackPanel Margin="30">

        <TextBlock Text="Body Fat Calculator"
                   FontSize="28"
                   Margin="0,0,0,30"/>

        <TextBlock Text="Height (cm)"/>
        <TextBox x:Name="HeightInput"
                 Margin="0,5,0,15"/>

        <TextBlock Text="Weight (kg)"/>
        <TextBox x:Name="WeightInput"
                 Margin="0,5,0,15"/>

        <TextBlock Text="Waist (cm)"/>
        <TextBox x:Name="WaistInput"
                 Margin="0,5,0,15"/>

        <TextBlock Text="Neck (cm)"/>
        <TextBox x:Name="NeckInput"
                 Margin="0,5,0,20"/>

        <Button Content="Calculate"
                Click="Calculate_Click"
                Height="40"/>

        <TextBlock x:Name="ResultText"
                   FontSize="22"
                   Margin="0,25,0,0"/>

    </StackPanel>
</Window>
